Number_1 = input('number_1: ')
operator = input('operator: ')
Number_2 = input('number_2: ')
if operator == '+':
    print(int(Number_1) + int(Number_2))
elif operator == '*':
    print(int(Number_1) * int(Number_2))
elif operator == '/':
    print(int(Number_1) / int(Number_2))
elif operator == '**':
    print(int(Number_1) ** int(Number_2))
elif operator == '-':
    print(int(Number_1) - int(Number_2))
